{
  "name": "@runweave/electron",
  "version": "0.131.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "node scripts/prepare-better-sqlite3-runtime.mjs && node scripts/prepare-whistle-runtime.mjs && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@runweave/shared": "workspace:*",
    "electron-updater": "^6.6.2",
    "pidusage": "^4.0.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "electron": "44.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "node-abi": "^4.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
