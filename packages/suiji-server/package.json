  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.0",
    "@types/busboy": "^1.5.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "esbuild": "0.25.12"
