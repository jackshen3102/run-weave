---
import "../styles/global.css";
import "../styles/responsive.css";
import "../styles/pages.css";
import Analytics from "../components/Analytics.astro";
interface Props { title?: string; notFound?: boolean; description?: string; }
const { title = "Runweave｜项目、终端与 Agent 的工作台", notFound = false } = Astro.props;
const description = Astro.props.description ?? "在电脑上组织项目与终端，运行 AI Agent，使用浏览器与本地工具。连接 Mac、Windows、Linux 后端，也支持手机查看与参与。";
const production = import.meta.env.WEBSITE_PRODUCTION;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(!production || notFound) && <meta name="robots" content="noindex, nofollow" />}
    {!notFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="128x128" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:alt" content="Runweave — 项目、终端与 Agent 的工作台。" />
    <meta name="theme-color" content="#f6f3ec" />
    {!notFound && <Analytics />}
  </head>
  <body data-clarity-mask="true"><a class="skip-link" href="#main">跳到正文</a><slot /></body>
</html>
