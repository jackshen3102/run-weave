---
import { guide, platforms } from "../data/home";
import Icon from "./Icon.astro";
---
<section id="machines" class="section usage" aria-labelledby="machines-title">
  <p class="section-kicker">按你的方式使用</p>
  <h2 id="machines-title">在你的电脑上，按你的方式使用。</h2>
  <div class="supported-platforms">
    <span>支持</span>
    <ul aria-label="支持的平台">
      {platforms.map(platform => <li><Icon name={platform.icon} /><span>{platform.name}</span></li>)}
    </ul>
  </div>
  <div class="usage-options">
    <article class="usage-option">
      <Icon name="desktop" />
      <div>
        <h3>桌面客户端</h3>
        <p>安装客户端，直接打开工作台。</p>
        <a href={guide}>开始使用 <span aria-hidden="true">↗</span></a>
      </div>
    </article>
    <article class="usage-option">
      <Icon name="browser" />
      <div>
        <h3>CLI 部署 + 网页访问</h3>
        <p>在电脑或服务器上部署，通过浏览器打开工作台。</p>
        <a href={`${guide}#install`}>查看部署指南 <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  </div>
</section>
