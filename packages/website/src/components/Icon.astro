---
interface Props { name: "macos" | "windows" | "linux" | "desktop" | "browser"; }
const { name } = Astro.props;
---
<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "macos" && <><path d="M24 10c1-4 4-6 7-6 0 4-3 7-7 7" fill="currentColor" stroke="none"/><path d="M29 12c-4-2-6 1-9 1s-5-3-9-1C3 16 8 30 13 35c3 3 5 0 8 0s5 3 8 0c3-3 5-7 6-10-6-2-7-9-1-12-2-1-3-1-5-1Z" fill="currentColor" stroke="none"/></>}
  {name === "windows" && <path d="M5 9l30-5v32L5 31V9Zm14-2v27M5 20h30"/>}
  {name === "linux" && <><path d="M13 14c0-6 2-10 7-10s7 4 7 10c0 5 5 9 5 15l-5 5H13l-5-5c0-6 5-10 5-15Z"/><ellipse cx="20" cy="25" rx="7" ry="9"/><path d="m16 14 4 3 4-3-4-2-4 2ZM12 31l-6 4 9 1 2-3m11-2 6 4-9 1-2-3"/><circle cx="17" cy="10" r="1" fill="currentColor"/><circle cx="23" cy="10" r="1" fill="currentColor"/></>}
  {(name === "desktop" || name === "browser") && <><rect x="3" y="5" width="34" height="30" rx="3"/><path d="M3 13h34"/><path d="M8 9h.1M13 9h.1M18 9h.1" stroke-width="2"/>{name === "desktop" ? <path d="m10 19 5 5-5 5m10 0h8"/> : <><circle cx="20" cy="24" r="8"/><ellipse cx="20" cy="24" rx="3.5" ry="8"/><path d="M12 24h16"/></>}</>}
</svg>
