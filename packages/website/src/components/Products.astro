---
import { Image } from "astro:assets";
import { products, repository } from "../data/home";
import notes from "../assets/product-notes.webp";
import journal from "../assets/product-journal.webp";
import remote from "../assets/product-remote.webp";
const visuals = {
  notes: { image: notes, alt: "随记界面示意：分类导航、想法与素材卡片，以及新增入口" },
  journal: { image: journal, alt: "屏幕日记界面示意：录屏列表、画面回放、播放控制与时间轴缩略图" },
  remote: { image: remote, alt: "远程桌面界面示意：横屏手机显示 Mac 桌面与悬浮控制栏" },
};
---
<section id="products" class="section products" aria-labelledby="products-title">
  <p class="section-kicker">更多产品 / AROUND YOUR WORK</p>
  <h2 id="products-title">也照顾工作前后的事情。</h2>
  <div class="product-grid">
  {products.map(product => (
    <a class="product-card" href={`${repository}/blob/main/${product.path}`}>
      <div class="product-copy">
        <h3>{product.name}</h3>
        <p>{product.description}</p>
      </div>
      <figure class="product-art">
        <Image src={visuals[product.kind].image} alt={visuals[product.kind].alt} widths={[160, 320, 480, 720]} sizes="(max-width: 340px) calc(100vw - 40px), (max-width: 760px) 300px, (max-width: 1100px) 28vw, 300px" loading="lazy" decoding="async" format="webp" />
        <figcaption>界面示意</figcaption>
      </figure>
      <span class="product-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
  </div>
</section>
