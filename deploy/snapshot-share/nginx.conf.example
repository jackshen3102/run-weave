# Replace share.example.com and certificate paths before enabling TLS.
server {
    listen 80;
    server_name share.example.com;
    access_log off;
    error_log /dev/null;
    location /.well-known/acme-challenge/ { root /var/www/runweave-share-acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name share.example.com;
    ssl_certificate /etc/letsencrypt/live/share.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/share.example.com/privkey.pem;
    # Signed read URLs and snapshot content must not enter access/error logs or proxy caches.
    access_log off;
    error_log /dev/null;
    client_max_body_size 61m;
    client_body_timeout 30s;

    location ^~ /share/terminal {
        proxy_pass http://127.0.0.1:8093;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }
    location = /api/snapshot-shares {
        proxy_pass http://127.0.0.1:8093;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 35s;
        proxy_set_header Host $host;
    }
    location / { return 404; }
}
