[Unit]
Description=Runweave public terminal snapshot host
After=network.target

[Service]
Type=simple
User=runweave-share
Group=runweave-share
# Set the installed Node 22+ executable path for this server.
ExecStart=/usr/bin/node /opt/runweave-snapshot-share/host.cjs --instance stable --config-dir /var/lib/runweave-snapshot-share/.runweave
WorkingDirectory=/var/lib/runweave-snapshot-share
StateDirectory=runweave-snapshot-share
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
